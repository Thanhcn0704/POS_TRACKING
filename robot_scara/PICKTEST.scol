PROGRAM PICKTEST
  CMD = 0
  ID = 0
  X = 0.0
  Y = 0.0
  Z = 0.0
  C = 0.0
  SHP = 0
  ACC = 0
  CKSUM = 0
  ZSAFE = 146.439
  GATE = 0
  XMIN = -207.0
  XMAX = 207.0
START:
  PRINT IP1, "REQ", CR
  INPUT IP1, ID, CMD, X, Y, Z, C, SHP
  ACC = ID + CMD + SHP
  ACC = ACC + INT(X + 1000)
  ACC = ACC + INT(Y + 1000)
  ACC = ACC + INT(Z + 1000)
  ACC = ACC + INT(C + 1000)
  CKSUM = ACC - INT(ACC / 65536) * 65536
  PRINT IP1, "ACK ", ID, " ", CKSUM, CR
  INPUT IP1, GATE
  IF GATE == 1 THEN GOTO EXECUTE
  GOTO START
EXECUTE:
  IF X < XMIN THEN GOTO REJECT
  IF X > XMAX THEN GOTO REJECT
  IF CMD == 1 THEN GOTO WAIT_BOUNDARY
  GOTO DO_PICK
WAIT_BOUNDARY:
  PWAIT = POINT(X + 10, Y, Z, C, 0.0, LEFTY)
  MOVE PWAIT
  PRINT IP1, "ARRIVED", CR
  GOTO START
DO_PICK:
  PAPPR = POINT(X + 10, Y, ZSAFE, C, 0.0, LEFTY)
  PPICK = POINT(X, Y, Z, C, 0.0, LEFTY)
  MOVE PAPPR
  MOVE PPICK
  MOVE PAPPR
  IF SHP == 1 THEN GOTO PLACE_CIRCLE
  IF SHP == 2 THEN GOTO PLACE_SQUARE
  GOTO PLACE_TRI
PLACE_CIRCLE:
  MOVE T2
  MOVE T1
  MOVE T2
  GOTO FIN
PLACE_SQUARE:
  MOVE T4
  MOVE T3
  MOVE T4
  GOTO FIN
PLACE_TRI:
  MOVE T6
  MOVE T5
  MOVE T6
FIN:
  PRINT IP1, "DONE", CR
  GOTO START
REJECT:
  PRINT IP1, "OUT", CR
  GOTO START
END
