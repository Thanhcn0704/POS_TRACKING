PROGRAM PICKTEST
  CMD = 0
  ID = 0
  X = 0.0
  Y = 0.0
  Z = 0.0
  C = 0.0
  SHP = 0
  ACC = 0
  CKSUM = 0
  ZLIFT = 146.439
  STXC$ = ""
  ETXC$ = ""
  GATE$ = ""
START:
  PRINT IP1, "REQ", CRE
  INPUT IP1, STXC$
  INPUT IP1, ID, CMD, X, Y, Z, C, SHP
  INPUT IP1, ETXC$
  ACC = ID + CMD + SHP
  ACC = ACC + INT(X + 1000)
  ACC = ACC + INT(Y + 1000)
  ACC = ACC + INT(Z + 1000)
  ACC = ACC + INT(C + 1000)
  CKSUM = ACC - INT(ACC / 65536) * 65536
  PRINT IP1, "ACK ", ID, " ", CKSUM, CRE
  INPUT IP1, GATE$
  IF GATE$ == "GO" THEN GOTO EXECUTE
  GOTO START
EXECUTE:
  IF CMD == 1 THEN GOTO WAIT_BOUNDARY
  GOTO DO_PICK
WAIT_BOUNDARY:
  PWAIT = POINT(X+10, Y, Z, C, 0.0)
  CONFIG = LEFTY
  MOVE PWAIT
  PRINT IP1, "ARRIVED", CRE
  GOTO START
DO_PICK:
  PAPPR = POINT(X+10, Y, ZLIFT, C, 0.0)
  PPICK = POINT(X, Y, Z, C, 0.0)
  CONFIG = LEFTY
  MOVE PAPPR
  MOVE PPICK
  MOVE PAPPR
  IF SHP == 1 THEN GOTO PLACE_CIRCLE
  IF SHP == 2 THEN GOTO PLACE_SQUARE
  GOTO PLACE_TRI
PLACE_CIRCLE:
  MOVE T2
  MOVE T1
  MOVE T2
  GOTO FIN
PLACE_SQUARE:
  MOVE T4
  MOVE T3
  MOVE T4
  GOTO FIN
PLACE_TRI:
  MOVE T6
  MOVE T5
  MOVE T6
FIN:
  PRINT IP1, "DONE", CRE
  GOTO START
END
